from zlib import crc32
'''
    Idea behind this is if we wanted to train our model again, we do not train on different 
    data since then our model would overfit. Instead we can keep a seed for rng, but if we
    added new data, that would be a problem, hence why we hash and if like lets say
    ration was 20%, we pick a hash such that any hash below hash is in training else 
    its in testing
'''
def is_id_in_test_set (indentifier, test_ratio):
    return crc32(np.int64(indentifier)) < test_ratio*2**32
def split_data_with_id_hash(data, test_ratio, id_column):
    ids = data[id_column]
    in_test_set = ids.apply(lambda id : is_id_in_test_set(id, test_ratio))
    return data.loc[~in_test_set], data.loc[in_test_set]
    


