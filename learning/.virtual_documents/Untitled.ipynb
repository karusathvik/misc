import numpy as np


def shuffle_split_data(data, test_ratio, rng):
    shuffle_i = rng.permutation(len(data))
    test_set_size = int(len(data)*test_ratio)
    test_i = shuffle_i[:test_set_size]
    train_i = shuffle_i[test_set_size:]
    return data.iloc[train_i], data.iloc[test_i]


rng = np.random.default_rng #the default random # gen
train_set, test_set = shuffle_split_data(housing_full, 0.2, rng) 



